{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "@dialog": {
      "background": {
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        },
        "base": "$background.raised.base"
      }
    },
    "background": {
      "action": {
        "destructive": {
          "base": "$hue.red.400"
        },
        "primary": {
          "$focused": "$hue.interactive.600",
          "$hovered": "$background.raised.base",
          "$selected": "$background.raised.max",
          "base": "transparent"
        },
        "secondary": {
          "$hovered": "$background.raised.base",
          "base": "transparent"
        }
      },
      "base": "$hue.neutral.900",
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      }
    },
    "border": {
      "base": "$hue.neutral.400"
    },
    "categorical": [
      "accent",
      "purple",
      "green",
      "blue",
      "red"
    ],
    "diff": {
      "background": {
        "added": "$hue.green.900",
        "context": "$background.raised.base",
        "removed": "$hue.red.900"
      },
      "highlight": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300"
      },
      "lineNumber": {
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        },
        "text": "$text.faint"
      },
      "text": {
        "added": "$hue.green.400",
        "context": "$hue.neutral.200",
        "hunkHeader": "$text.faint",
        "removed": "$hue.red.400"
      }
    },
    "markdown": {
      "blockQuote": "$hue.neutral.300",
      "code": "$hue.orange.400",
      "codeBlock": "$hue.orange.400",
      "emphasis": "$hue.purple.400",
      "heading": "$hue.blue.400",
      "horizontalRule": "$hue.neutral.300",
      "image": "$hue.cyan.400",
      "imageText": "$hue.cyan.400",
      "link": "$hue.cyan.400",
      "linkText": "$hue.cyan.400",
      "listEnumeration": "$hue.cyan.400",
      "listItem": "$hue.blue.400",
      "strong": "$hue.yellow.400",
      "text": "$hue.neutral.100"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "function": "$hue.green.400",
      "keyword": "$hue.red.400",
      "number": "$hue.purple.400",
      "operator": "$hue.neutral.200",
      "punctuation": "$hue.neutral.200",
      "string": "$hue.orange.400",
      "type": "$hue.blue.400",
      "variable": "$hue.neutral.100"
    },
    "text": {
      "action": {
        "destructive": {
          "$disabled": "$text.faint",
          "base": "$hue.neutral.900"
        },
        "primary": {
          "$disabled": "$text.faint",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.200",
          "base": "$text.base"
        },
        "secondary": {
          "$focused": "$hue.interactive.200",
          "$hovered": "$text.base",
          "base": "$text.muted"
        }
      },
      "base": "$hue.neutral.100",
      "faint": "$hue.neutral.300",
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "info": {
          "base": "$hue.blue.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "warning": {
          "base": "$hue.yellow.400"
        }
      },
      "formfield": {
        "$disabled": "$text.faint",
        "$focused": "$hue.interactive.400",
        "$hovered": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$selected": "$hue.interactive.400",
        "base": "$text.base"
      },
      "muted": "$hue.neutral.200"
    }
  },
  "light": {
    "@dialog": {
      "background": {
        "base": "$hue.neutral.800"
      }
    },
    "background": {
      "feedback": {
        "error": {
          "base": "#e5cfbb"
        },
        "info": {
          "base": "#d8d8ca"
        },
        "success": {
          "base": "#dad9b8"
        },
        "warning": {
          "base": "#e0d6b5"
        }
      },
      "raised": {
        "base": "$hue.neutral.800",
        "high": "#e4dbb6",
        "max": "$hue.neutral.600"
      }
    },
    "diff": {
      "background": {
        "added": "#E4EBCB",
        "context": "#E9E1BF",
        "removed": "#F2DAD9"
      },
      "highlight": {
        "added": "#4d5d2e",
        "removed": "#80323b"
      },
      "lineNumber": {
        "background": {
          "added": "#d3dcb8",
          "removed": "#e8c5c7"
        },
        "text": "#6B6657"
      },
      "text": {
        "added": "#546D2C",
        "context": "#615C4D",
        "hunkHeader": "#6B6657",
        "removed": "#9D2F3F"
      }
    },
    "hue": {
      "accent": "$hue.yellow",
      "blue": {
        "100": "#2a3a55",
        "200": "#3a4f74",
        "300": "#455f8c",
        "400": "#4D699B",
        "500": "#7f91ac",
        "600": "#b4bbbe",
        "700": "#d2d3c8",
        "800": "#e2e0cd",
        "900": "#ebe6d0"
      },
      "cyan": {
        "100": "#1c3b37",
        "200": "#26504b",
        "300": "#2e605a",
        "400": "#336B64",
        "500": "#6d9285",
        "600": "#aabca9",
        "700": "#cdd3bd",
        "800": "#e0e0c8",
        "900": "#e9e7cd"
      },
      "gray": {
        "100": "#3B3833",
        "200": "#615C4D",
        "300": "#6B6657",
        "400": "#B4AA84",
        "500": "#B8AA76",
        "600": "#DED4AC",
        "700": "#E9E1BF",
        "800": "#EFE8CB",
        "900": "#F3EDD3"
      },
      "green": {
        "100": "#2e3c18",
        "200": "#3f5221",
        "300": "#4c6228",
        "400": "#546D2C",
        "500": "#84935e",
        "600": "#b7bc94",
        "700": "#d3d3b2",
        "800": "#e3e0c2",
        "900": "#ebe7cb"
      },
      "interactive": "$hue.blue",
      "neutral": "$hue.gray",
      "orange": {
        "100": "#4f320a",
        "200": "#6b440e",
        "300": "#815110",
        "400": "#8F5A12",
        "500": "#ad864c",
        "600": "#cdb58a",
        "700": "#dfd0ac",
        "800": "#e9dec0",
        "900": "#eee6c9"
      },
      "purple": {
        "100": "#3e2e54",
        "200": "#553e73",
        "300": "#664b8a",
        "400": "#715399",
        "500": "#9881aa",
        "600": "#c2b2bd",
        "700": "#d9cec7",
        "800": "#e6decd",
        "900": "#ede5d0"
      },
      "red": {
        "100": "#561a23",
        "200": "#76232f",
        "300": "#8d2a39",
        "400": "#9D2F3F",
        "500": "#b7686b",
        "600": "#d2a59b",
        "700": "#e2c7b5",
        "800": "#eadac4",
        "900": "#efe4cc"
      },
      "yellow": {
        "100": "#43340d",
        "200": "#5c4711",
        "300": "#6e5615",
        "400": "#7A5F17",
        "500": "#9e8a4f",
        "600": "#c5b78c",
        "700": "#dbd1ad",
        "800": "#e7dfc0",
        "900": "#ede6ca"
      }
    },
    "scrollbar": {
      "base": "#d7cfaf"
    },
    "text": {
      "muted": "#45636F"
    }
  }
}
