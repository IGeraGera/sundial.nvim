{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "@dialog": {
      "background": {
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        },
        "base": "$background.raised.base"
      }
    },
    "background": {
      "action": {
        "destructive": {
          "base": "$hue.red.400"
        },
        "primary": {
          "$focused": "$hue.interactive.600",
          "$hovered": "$background.raised.base",
          "$selected": "$background.raised.max",
          "base": "transparent"
        },
        "secondary": {
          "$hovered": "$background.raised.base",
          "base": "transparent"
        }
      },
      "base": "$hue.neutral.900",
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      }
    },
    "border": {
      "base": "$hue.neutral.400"
    },
    "categorical": [
      "accent",
      "purple",
      "green",
      "blue",
      "red"
    ],
    "diff": {
      "background": {
        "added": "$hue.green.900",
        "context": "$background.raised.base",
        "removed": "$hue.red.900"
      },
      "highlight": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300"
      },
      "lineNumber": {
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        },
        "text": "$text.faint"
      },
      "text": {
        "added": "$hue.green.400",
        "context": "$hue.neutral.200",
        "hunkHeader": "$text.faint",
        "removed": "$hue.red.400"
      }
    },
    "markdown": {
      "blockQuote": "$hue.neutral.300",
      "code": "$hue.orange.400",
      "codeBlock": "$hue.orange.400",
      "emphasis": "$hue.purple.400",
      "heading": "$hue.blue.400",
      "horizontalRule": "$hue.neutral.300",
      "image": "$hue.cyan.400",
      "imageText": "$hue.cyan.400",
      "link": "$hue.cyan.400",
      "linkText": "$hue.cyan.400",
      "listEnumeration": "$hue.cyan.400",
      "listItem": "$hue.blue.400",
      "strong": "$hue.yellow.400",
      "text": "$hue.neutral.100"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "function": "$hue.green.400",
      "keyword": "$hue.red.400",
      "number": "$hue.purple.400",
      "operator": "$hue.neutral.200",
      "punctuation": "$hue.neutral.200",
      "string": "$hue.orange.400",
      "type": "$hue.blue.400",
      "variable": "$hue.neutral.100"
    },
    "text": {
      "action": {
        "destructive": {
          "$disabled": "$text.faint",
          "base": "$hue.neutral.900"
        },
        "primary": {
          "$disabled": "$text.faint",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.200",
          "base": "$text.base"
        },
        "secondary": {
          "$focused": "$hue.interactive.200",
          "$hovered": "$text.base",
          "base": "$text.muted"
        }
      },
      "base": "$hue.neutral.100",
      "faint": "$hue.neutral.300",
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "info": {
          "base": "$hue.blue.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "warning": {
          "base": "$hue.yellow.400"
        }
      },
      "formfield": {
        "$disabled": "$text.faint",
        "$focused": "$hue.interactive.400",
        "$hovered": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$selected": "$hue.interactive.400",
        "base": "$text.base"
      },
      "muted": "$hue.neutral.200"
    }
  },
  "dark": {
    "background": {
      "feedback": {
        "error": {
          "base": "#2a222a"
        },
        "info": {
          "base": "#202931"
        },
        "success": {
          "base": "#222926"
        },
        "warning": {
          "base": "#292823"
        }
      }
    },
    "diff": {
      "background": {
        "added": "#1A2923",
        "context": "#171C23",
        "removed": "#30222B"
      },
      "highlight": {
        "added": "#a5b692",
        "removed": "#c897a1"
      },
      "lineNumber": {
        "background": {
          "added": "#28392e",
          "removed": "#422d38"
        },
        "text": "#8B8994"
      },
      "text": {
        "added": "#91AE80",
        "context": "#A89F90",
        "hunkHeader": "#8B8994",
        "removed": "#C48196"
      }
    },
    "hue": {
      "accent": "$hue.yellow",
      "blue": {
        "100": "#c8d9e4",
        "200": "#b0c8d9",
        "300": "#97b7cd",
        "400": "#85AAC4",
        "500": "#617c90",
        "600": "#3b4b58",
        "700": "#252f38",
        "800": "#191f27",
        "900": "#13181e"
      },
      "cyan": {
        "100": "#c1dbd8",
        "200": "#a6cac6",
        "300": "#8bbab5",
        "400": "#76AEA8",
        "500": "#577f7c",
        "600": "#354c4d",
        "700": "#223032",
        "800": "#182024",
        "900": "#12181c"
      },
      "gray": {
        "100": "#D2CABB",
        "200": "#A89F90",
        "300": "#8B8994",
        "400": "#536170",
        "500": "#40566A",
        "600": "#293541",
        "700": "#1B222B",
        "800": "#171C23",
        "900": "#0D1015"
      },
      "green": {
        "100": "#cedbc6",
        "200": "#b8caac",
        "300": "#a2ba93",
        "400": "#91AE80",
        "500": "#697f60",
        "600": "#3f4c3e",
        "700": "#27302a",
        "800": "#1a2020",
        "900": "#14181a"
      },
      "interactive": "$hue.blue",
      "neutral": "$hue.gray",
      "orange": {
        "100": "#e4ceb2",
        "200": "#d9b890",
        "300": "#cda26e",
        "400": "#C49254",
        "500": "#8d6b41",
        "600": "#53412d",
        "700": "#322a22",
        "800": "#1f1d1b",
        "900": "#161718"
      },
      "purple": {
        "100": "#d9d0e3",
        "200": "#c8bbd7",
        "300": "#b8a7ca",
        "400": "#AB97C1",
        "500": "#7c6f8d",
        "600": "#494356",
        "700": "#2d2b37",
        "800": "#1d1e26",
        "900": "#15171e"
      },
      "red": {
        "100": "#e4c6d0",
        "200": "#d9adbb",
        "300": "#cd94a6",
        "400": "#C48196",
        "500": "#8d5f6f",
        "600": "#533b46",
        "700": "#32272f",
        "800": "#1f1b22",
        "900": "#16161b"
      },
      "yellow": {
        "100": "#e0d7bc",
        "200": "#d3c59f",
        "300": "#c5b381",
        "400": "#BBA66B",
        "500": "#877951",
        "600": "#4f4936",
        "700": "#302e26",
        "800": "#1e1f1e",
        "900": "#161819"
      }
    },
    "scrollbar": {
      "base": "#2d343e"
    },
    "text": {
      "muted": "#819FB7"
    }
  }
}
